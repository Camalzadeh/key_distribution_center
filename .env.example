# Copy to .env for local development. .env is gitignored and must stay that
# way — see .gitignore and .dockerignore, both of which exclude it by name and
# by shape.
#
#   cp .env.example .env
#   docker compose up --build
#
# Pick your own password; this file ships a placeholder rather than a working
# value on purpose. Anything a reader can copy and run unchanged becomes the
# password everyone uses.
POSTGRES_DB=kdc
POSTGRES_USER=kdc
POSTGRES_PASSWORD=change-me-before-first-run
